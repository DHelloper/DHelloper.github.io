[["Map",1,2,9,10],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.18.2","content-config-digest","aaaa82890170405c","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"https://DHelloper.github.io\",\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[],\"actionBodySizeLimit\":1048576},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false}}","posts",["Map",11,12,62,63],"database/postgresql-index",{"id":11,"data":13,"body":19,"filePath":20,"digest":21,"rendered":22},{"title":14,"description":15,"category":16,"pubDate":17,"draft":18},"PostgreSQL Index를 적용하면 정말 빨라질까?","100만 건 데이터를 기준으로 PostgreSQL Index 성능을 비교한 실험","Database",["Date","2026-08-31T00:00:00.000Z"],false,"# PostgreSQL Index를 적용하면 정말 빨라질까?\n\n## 1. 문제\n데이터가 많아졌을 때 단순 조회 쿼리가 얼마나 느려지는지 확인하고 Index 적용 전후를 검증한다.\n\n## 2. 실험 환경\n- PostgreSQL:\n- 데이터: 1,000,000 rows\n- CPU:\n- Memory:\n\n## 3. Before\n```sql\nSELECT * FROM contents WHERE user_id = 100;\n```\n\n## 4. EXPLAIN ANALYZE\n```sql\nEXPLAIN ANALYZE SELECT * FROM contents WHERE user_id = 100;\n```\n\n## 5. Index 적용\n```sql\nCREATE INDEX idx_contents_user_id ON contents(user_id);\n```\n\n## 6. 결과\n| 지표 | Before | After |\n|---|---:|---:|\n| Average | - | - |\n| P95 | - | - |\n| P99 | - | - |\n| Execution Time | - | - |\n\n## 7. 분석\n실제 실행 계획과 측정 결과를 작성한다.\n\n## 8. Trade-off\nIndex는 조회 성능을 높이지만 INSERT/UPDATE 비용과 저장 공간을 증가시킨다.\n\n## 9. 면접 질문\n- Index는 왜 빠른가?\n- Index를 많이 만들면 좋은가?","src/content/posts/database/postgresql-index/index.md","705013dc9f0b9748",{"html":23,"metadata":24},"\u003Ch1 id=\"postgresql-index를-적용하면-정말-빨라질까\">PostgreSQL Index를 적용하면 정말 빨라질까?\u003C/h1>\n\u003Ch2 id=\"1-문제\">1. 문제\u003C/h2>\n\u003Cp>데이터가 많아졌을 때 단순 조회 쿼리가 얼마나 느려지는지 확인하고 Index 적용 전후를 검증한다.\u003C/p>\n\u003Ch2 id=\"2-실험-환경\">2. 실험 환경\u003C/h2>\n\u003Cul>\n\u003Cli>PostgreSQL:\u003C/li>\n\u003Cli>데이터: 1,000,000 rows\u003C/li>\n\u003Cli>CPU:\u003C/li>\n\u003Cli>Memory:\u003C/li>\n\u003C/ul>\n\u003Ch2 id=\"3-before\">3. Before\u003C/h2>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"sql\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">SELECT\u003C/span>\u003Cspan style=\"color:#F97583\"> *\u003C/span>\u003Cspan style=\"color:#F97583\"> FROM\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> contents \u003C/span>\u003Cspan style=\"color:#F97583\">WHERE\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> user_id \u003C/span>\u003Cspan style=\"color:#F97583\">=\u003C/span>\u003Cspan style=\"color:#79B8FF\"> 100\u003C/span>\u003Cspan style=\"color:#E1E4E8\">;\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"4-explain-analyze\">4. EXPLAIN ANALYZE\u003C/h2>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"sql\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">EXPLAIN ANALYZE \u003C/span>\u003Cspan style=\"color:#F97583\">SELECT\u003C/span>\u003Cspan style=\"color:#F97583\"> *\u003C/span>\u003Cspan style=\"color:#F97583\"> FROM\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> contents \u003C/span>\u003Cspan style=\"color:#F97583\">WHERE\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> user_id \u003C/span>\u003Cspan style=\"color:#F97583\">=\u003C/span>\u003Cspan style=\"color:#79B8FF\"> 100\u003C/span>\u003Cspan style=\"color:#E1E4E8\">;\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"5-index-적용\">5. Index 적용\u003C/h2>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"sql\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">CREATE\u003C/span>\u003Cspan style=\"color:#F97583\"> INDEX\u003C/span>\u003Cspan style=\"color:#B392F0\"> idx_contents_user_id\u003C/span>\u003Cspan style=\"color:#F97583\"> ON\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> contents(user_id);\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"6-결과\">6. 결과\u003C/h2>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>지표\u003C/th>\u003Cth align=\"right\">Before\u003C/th>\u003Cth align=\"right\">After\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>Average\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>P95\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>P99\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Execution Time\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\n\u003Ch2 id=\"7-분석\">7. 분석\u003C/h2>\n\u003Cp>실제 실행 계획과 측정 결과를 작성한다.\u003C/p>\n\u003Ch2 id=\"8-trade-off\">8. Trade-off\u003C/h2>\n\u003Cp>Index는 조회 성능을 높이지만 INSERT/UPDATE 비용과 저장 공간을 증가시킨다.\u003C/p>\n\u003Ch2 id=\"9-면접-질문\">9. 면접 질문\u003C/h2>\n\u003Cul>\n\u003Cli>Index는 왜 빠른가?\u003C/li>\n\u003Cli>Index를 많이 만들면 좋은가?\u003C/li>\n\u003C/ul>",{"headings":25,"localImagePaths":57,"remoteImagePaths":58,"frontmatter":59,"imagePaths":61},[26,29,33,36,39,42,45,48,51,54],{"depth":27,"slug":28,"text":14},1,"postgresql-index를-적용하면-정말-빨라질까",{"depth":30,"slug":31,"text":32},2,"1-문제","1. 문제",{"depth":30,"slug":34,"text":35},"2-실험-환경","2. 실험 환경",{"depth":30,"slug":37,"text":38},"3-before","3. Before",{"depth":30,"slug":40,"text":41},"4-explain-analyze","4. EXPLAIN ANALYZE",{"depth":30,"slug":43,"text":44},"5-index-적용","5. Index 적용",{"depth":30,"slug":46,"text":47},"6-결과","6. 결과",{"depth":30,"slug":49,"text":50},"7-분석","7. 분석",{"depth":30,"slug":52,"text":53},"8-trade-off","8. Trade-off",{"depth":30,"slug":55,"text":56},"9-면접-질문","9. 면접 질문",[],[],{"title":14,"description":15,"category":16,"pubDate":60},["Date","2026-08-31T00:00:00.000Z"],[],"redis/redis-cache",{"id":62,"data":64,"body":69,"filePath":70,"digest":71,"rendered":72},{"title":65,"description":66,"category":67,"pubDate":68,"draft":18},"Redis Cache 적용 전후 성능 비교","Cache Aside 패턴을 적용하고 성능을 비교한 실험","Redis",["Date","2026-08-31T00:00:00.000Z"],"# Redis Cache 적용 전후 성능 비교\n\n## 1. 문제\n조회 요청이 많아질 때 DB에 모든 요청이 집중되는 문제를 재현하고 Redis Cache 적용 효과를 측정한다.\n\n## 2. Before\n```text\nClient → Application → PostgreSQL\n```\n\n## 3. After\n```text\nClient → Application → Redis\n                         ↓ Cache Miss\n                      PostgreSQL\n```\n\n## 4. 결과\n| 지표 | DB Only | Redis Cache |\n|---|---:|---:|\n| Average | - | - |\n| P95 | - | - |\n| P99 | - | - |\n| RPS | - | - |\n| DB CPU | - | - |\n\n## 5. 분석\n실제 부하 테스트 결과를 바탕으로 병목이 어떻게 이동했는지 기록한다.\n\n## 6. Trade-off\nCache는 조회 성능을 높이지만 정합성, 만료, Cache Stampede 등을 고려해야 한다.\n\n## 7. 면접 질문\n- 왜 Redis를 사용했는가?\n- Cache Aside란 무엇인가?\n- Redis 장애가 발생하면 어떻게 할 것인가?","src/content/posts/redis/redis-cache/index.md","588a3ecea534f5c6",{"html":73,"metadata":74},"\u003Ch1 id=\"redis-cache-적용-전후-성능-비교\">Redis Cache 적용 전후 성능 비교\u003C/h1>\n\u003Ch2 id=\"1-문제\">1. 문제\u003C/h2>\n\u003Cp>조회 요청이 많아질 때 DB에 모든 요청이 집중되는 문제를 재현하고 Redis Cache 적용 효과를 측정한다.\u003C/p>\n\u003Ch2 id=\"2-before\">2. Before\u003C/h2>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"text\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan>Client → Application → PostgreSQL\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"3-after\">3. After\u003C/h2>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"text\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan>Client → Application → Redis\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan>                         ↓ Cache Miss\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan>                      PostgreSQL\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch2 id=\"4-결과\">4. 결과\u003C/h2>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>지표\u003C/th>\u003Cth align=\"right\">DB Only\u003C/th>\u003Cth align=\"right\">Redis Cache\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>Average\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>P95\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>P99\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>RPS\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>DB CPU\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003Ctd align=\"right\">-\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\n\u003Ch2 id=\"5-분석\">5. 분석\u003C/h2>\n\u003Cp>실제 부하 테스트 결과를 바탕으로 병목이 어떻게 이동했는지 기록한다.\u003C/p>\n\u003Ch2 id=\"6-trade-off\">6. Trade-off\u003C/h2>\n\u003Cp>Cache는 조회 성능을 높이지만 정합성, 만료, Cache Stampede 등을 고려해야 한다.\u003C/p>\n\u003Ch2 id=\"7-면접-질문\">7. 면접 질문\u003C/h2>\n\u003Cul>\n\u003Cli>왜 Redis를 사용했는가?\u003C/li>\n\u003Cli>Cache Aside란 무엇인가?\u003C/li>\n\u003Cli>Redis 장애가 발생하면 어떻게 할 것인가?\u003C/li>\n\u003C/ul>",{"headings":75,"localImagePaths":97,"remoteImagePaths":98,"frontmatter":99,"imagePaths":101},[76,78,79,82,85,88,91,94],{"depth":27,"slug":77,"text":65},"redis-cache-적용-전후-성능-비교",{"depth":30,"slug":31,"text":32},{"depth":30,"slug":80,"text":81},"2-before","2. Before",{"depth":30,"slug":83,"text":84},"3-after","3. After",{"depth":30,"slug":86,"text":87},"4-결과","4. 결과",{"depth":30,"slug":89,"text":90},"5-분석","5. 분석",{"depth":30,"slug":92,"text":93},"6-trade-off","6. Trade-off",{"depth":30,"slug":95,"text":96},"7-면접-질문","7. 면접 질문",[],[],{"title":65,"description":66,"category":67,"pubDate":100},["Date","2026-08-31T00:00:00.000Z"],[]]