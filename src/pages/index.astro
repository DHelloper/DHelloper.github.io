---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---
<Layout title="Backend Developer">
<section class="hero"><div class="container">
<p class="eyebrow">BACKEND DEVELOPER · STUDY · ENGINEERING</p>
<h1>문제를 분석하고<br/><span>성능으로 증명하는 개발자</span></h1>
<p class="lead">Java · Spring · PostgreSQL · Redis를 중심으로<br/>실무 문제를 직접 실험하고 기록합니다.</p>
<div class="actions"><a class="button primary" href="/posts">기술 블로그 보기</a><a class="button" href="https://github.com/DHelloper">GitHub</a></div>
</div></section>
<section class="section"><div class="container">
<div class="section-head"><div><p class="eyebrow">RECENT POSTS</p><h2>최근 기록</h2></div><a href="/posts">전체 보기 →</a></div>
<div class="grid">{posts.map((post) => <a class="card" href={`/posts/${post.id}`}><span class="tag">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="read">Read more →</span></a>)}</div>
</div></section>
<section class="section muted"><div class="container">
<p class="eyebrow">LEARNING PIPELINE</p><h2>공부한 것을 결과물로 남깁니다.</h2>
<div class="pipeline"><span>공부</span><b>→</b><span>구현</span><b>→</b><span>실험</span><b>→</b><span>측정</span><b>→</b><span>GitHub</span><b>→</b><span>Blog</span><b>→</b><span>면접</span></div>
</div></section>
</Layout>
