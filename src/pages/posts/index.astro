---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const groups = new Map();
for (const post of posts) {
  const slug = post.id.split("/")[0];
  if (!groups.has(slug)) groups.set(slug, { slug, label: post.data.category, posts: [] });
  groups.get(slug).posts.push(post);
}
const categories = [...groups.values()]
  .map((g) => ({ ...g, posts: g.posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) }))
  .sort((a, b) => b.posts[0].data.pubDate.valueOf() - a.posts[0].data.pubDate.valueOf());
---
<Layout title="Posts"><section class="page"><div class="container">
<p class="eyebrow">TECHNICAL BLOG</p><h1>Posts</h1><p class="lead">직접 구현하고 측정한 백엔드 기술 기록입니다.</p>
{categories.map((category) => <div class="category-group">
<div class="section-head"><h2><a href={`/posts/${category.slug}`}>{category.label}</a></h2><span class="count">{category.posts.length}개</span></div>
<div class="post-list">{category.posts.map((post) => <a class="post-row" href={`/posts/${post.id}`}><span class="tag">{post.data.category}</span><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span>→</span></a>)}</div>
</div>)}
</div></section></Layout>
